# Copier ce fichier en .env et remplacer les valeurs fictives.
# Ne jamais committer le fichier .env.

# development | test | production
NODE_ENV=development
# Port HTTP de l'API
PORT=3001
# URI MongoDB (en Docker : mongodb://mongodb:27017/thebaroness)
MONGODB_URI=mongodb://localhost:27017/thebaroness
# Clé de signature JWT, au moins 32 caractères aléatoires (ex. : openssl rand -hex 32)
JWT_SECRET=remplacer-par-une-cle-aleatoire-de-32-caracteres-minimum
# Durée de vie du jeton (15m, 1h, 1d…). Pas de refresh : 1h conseillé en développement
JWT_EXPIRES_IN=1h
# URL publique de l'API (sans /api) : realm et adresse de retour Steam OpenID
API_PUBLIC_URL=http://localhost:3001
# URL du front : Steam y renvoie l'utilisateur (route /auth/callback)
FRONT_URL=http://localhost:5173
# Requêtes /api/auth/* autorisées par IP et par fenêtre de 15 minutes
AUTH_RATE_LIMIT=60
# Requêtes /api/* autorisées par IP et par minute
API_RATE_LIMIT=300
# Nombre de proxys inverses devant l'API (0 en direct, 1 derrière nginx)
TRUST_PROXY=0
# Origines autorisées par CORS, séparées par des virgules
CORS_ORIGIN=http://localhost:5173
# API Deadlock communautaire
DEADLOCK_API_BASE_URL=https://api.deadlock-api.com
# Clé API Deadlock facultative (jamais exposée au navigateur)
DEADLOCK_API_KEY=
# Worker de préchauffage du cache (joueurs suivis et membres de groupes) : true | false
REFRESH_WORKER_ENABLED=true
# Délai entre deux cycles du worker, en ms (minimum 60000)
REFRESH_INTERVAL_MS=300000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
